# Config server bootstrap. These are required locally so the service can fetch
# its baseline config.
CONFIG_SERVER_URL=http://<config-server-host>:<config-server-port>/<config-path>
CONFIG_APP_NAME=ai-rag-query-service
CONFIG_PROFILE=main
CONFIG_TAG=v1
CONFIG_SERVER_TIMEOUT=5
CONFIG_SERVER_REQUIRED=true
ALLOW_LOCAL_CONFIG_OVERRIDES=true

# Local runtime values. Leave blank to use the config-server value.
APP_ENV=dev

RAG_SERVICE_APP_NAME=

OPENAI_API_KEY=
EMBEDDING_MODEL=
EMBEDDING_DIMENSION=
LOCAL_EMBEDDING_MODEL=

MILVUS_HOST=
MILVUS_PORT=
MILVUS_DB_NAME=
MILVUS_COLLECTION_NAME=
MILVUS_COLLECTION_NAME_LOCAL=

OLLAMA_BASE_URL=
RAG_SUMMARIZER_LOCAL_LLM=
RAG_SUMMARIZER_PUBLIC_LLM=
GET_SUMMARY_TIMEOUT_LOCAL=
RAG_SUMMARY_MAX_WORDS=

MINIO_HOST=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_SECURE=
MINIO_BUCKET=
MINIO_PRESIGNED_URL_EXPIRY_SECONDS=

RAG_ONLY_SYSTEM_PROMPT=
RAG_WITH_PUBLIC_INFO_SYSTEM_PROMPT=
PUBLIC_INFO_ONLY_SYSTEM_PROMPT=
